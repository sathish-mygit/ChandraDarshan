{
  "name": "chandra-darshan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3002",
    "build": "node scripts/resolve-android-package.cjs && node scripts/increment-build.cjs && node scripts/next-build.mjs && npx cap sync android",
    "build:web": "next build",
    "build:mobile": "npm run build",
    "build:android": "node scripts/build-android.mjs",
    "build:android:dev": "node scripts/build-android.mjs dev",
    "build:android:prod": "node scripts/build-android.mjs prod",
    "build:android:dev:release": "node scripts/build-android.mjs dev release",
    "build:android:prod:debug": "node scripts/build-android.mjs prod debug",
    "build:shared": "node scripts/set-package-mode.cjs shared && npm run build",
    "build:isolated": "node scripts/set-package-mode.cjs isolate && npm run build",
    "build:reset-package": "node scripts/set-package-mode.cjs auto",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:android": "npm run cap:sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^7.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "16.2.10",
    "panchang-ts": "^4.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
