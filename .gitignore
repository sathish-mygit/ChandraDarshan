# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — commit templates; ignore local overrides
.env.local
.env*.local

# generated build pipeline artifacts
android/.package-resolved.json
.capacitor-package-mode
android/app/src/prod/google-services.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# regenerated on each build from buildinfo-{branch}.json (see scripts/increment-build.cjs)
# src/config/buildinfo-generated.ts — committed fallback; overwritten locally on build
