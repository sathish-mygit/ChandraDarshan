# Local overrides — copy to .env.local (gitignored).
# Do not commit secrets here.

# Env file model:
#   .env.development  — dev flavor builds (auto on non-main branches)
#   .env.production   — prod flavor builds (auto on main/master)
#   .env.local        — your machine-only overrides (optional)

NEXT_PUBLIC_TEST_MODE=true

NEXT_PUBLIC_TEST_MODE=true

# Ads (native Android — see docs/03-setup/03-admob.md)
# NEXT_PUBLIC_ADS_ENABLED=true
# NEXT_PUBLIC_AD_USE_GOOGLE_SAMPLE_UNITS=true
# NEXT_PUBLIC_ADS_FALLBACK_WHEN_NO_JYOTISH=false
# NEXT_PUBLIC_ADS_FALLBACK_HOME=false
# NEXT_PUBLIC_ADS_FALLBACK_SETTINGS=false
# NEXT_PUBLIC_ADMOB_APP_ID_ANDROID=
# NEXT_PUBLIC_ADMOB_INTERSTITIAL_AD_UNIT_ID_ANDROID=

